{
  "name": "rootpermit-service-workspace",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "service/*"
  ],
  "engines": {
    "node": "24.14.0"
  },
  "scripts": {
    "check": "npm run typecheck --workspaces --if-present && npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "ci:contract": "node --test ci/*.test.mjs && node ci/validate-fixtures.mjs fixtures"
  },
  "devDependencies": {
    "ajv": "^8.20.0"
  }
}
