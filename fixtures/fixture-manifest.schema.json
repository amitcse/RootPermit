{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rootpermit.dev/schemas/fixture-manifest-v1.json",
  "title": "RootPermit APT fixture manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "fixture_id", "status", "platform", "purpose"],
  "properties": {
    "schema_version": { "const": 1 },
    "fixture_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$" },
    "status": { "enum": ["contract-only", "provisioning-ready", "ready"] },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "release", "architecture"],
      "properties": {
        "os": { "type": "string", "minLength": 1, "maxLength": 64 },
        "release": { "type": "string", "minLength": 1, "maxLength": 64 },
        "architecture": { "enum": ["amd64", "arm64"] }
      }
    },
    "purpose": { "type": "string", "minLength": 1, "maxLength": 240 },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["locator", "sha256", "format", "publisher_checksum_url"],
      "properties": {
        "locator": { "type": "string", "pattern": "^https://", "maxLength": 512 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "format": { "enum": ["qcow2"] },
        "publisher_checksum_url": { "type": "string", "pattern": "^https://", "maxLength": 512 }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kernel", "apt_version", "dpkg_version"],
      "properties": {
        "kernel": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+-[0-9]+-generic$" },
        "apt_version": { "type": "string", "minLength": 1, "maxLength": 128 },
        "dpkg_version": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    },
    "apt_repositories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["uri", "suite", "components", "snapshot_id"],
        "properties": {
          "uri": { "type": "string", "pattern": "^https://", "maxLength": 512 },
          "suite": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "components": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "pattern": "^[a-z0-9-]+$" }
          },
          "snapshot_id": { "type": "string", "pattern": "^[0-9]{8}T[0-9]{6}Z$" }
        }
      }
    },
    "artifact_retention": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "retention_days"],
      "properties": {
        "path": { "type": "string", "pattern": "^artifacts/", "maxLength": 256 },
        "retention_days": { "type": "integer", "minimum": 7, "maximum": 90 }
      }
    },
    "sealed_inputs": { "type": "object" },
    "evidence_bundle": { "type": "object" }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "contract-only" } } },
      "then": {
        "not": { "anyOf": [ { "required": ["image"] }, { "required": ["sealed_inputs"] }, { "required": ["evidence_bundle"] } ] }
      }
    },
    {
      "if": { "properties": { "status": { "const": "provisioning-ready" } } },
      "then": { "required": ["image", "runtime", "apt_repositories", "artifact_retention"] }
    },
    {
      "if": { "properties": { "status": { "const": "ready" } } },
      "then": { "required": ["image", "runtime", "apt_repositories", "artifact_retention", "sealed_inputs", "evidence_bundle"] }
    }
  ]
}
